# AGX local camera-to-phone web preview defaults.
# Values passed before a script, such as WIDTH=640 FPS=30 ./scripts/..., win.

: "${CAMERA_DEVICE:=/dev/video6}"
: "${WIDTH:=1280}"
: "${HEIGHT:=800}"
: "${FPS:=60}"
: "${JPEG_QUALITY:=95}"
: "${HTTP_HOST:=0.0.0.0}"
: "${HTTP_PORT:=8080}"
: "${RECORD:=1}"
: "${RECORD_DIR:=records}"
: "${RECORD_PREFIX:=agx_web}"
: "${RECORD_FPS:=30}"
: "${MP4_BITRATE_KBPS:=1200}"
: "${CONTROL_SOCKET:=/tmp/ball_nx_control.sock}"
: "${CONTROL_TIMEOUT_MS:=500}"

# AGX hotspot defaults.
: "${HOTSPOT_SSID:=AGX-336L}"
: "${HOTSPOT_PASSWORD:=agx336l888}"
: "${HOTSPOT_ADDRESS:=192.168.88.1/24}"
: "${HOTSPOT_CHANNEL:=149}"
